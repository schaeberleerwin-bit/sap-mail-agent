# Postfach, das in Outlook eingebunden ist
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Ordnername laut: python mail_agent.py --list-folders
IMAP_DRAFTS_FOLDER=Entwürfe
# Nur Mails von dieser Adresse werden verarbeitet
DEMO_SENDER=
GROQ_API_KEY=
# Modellname live prüfen (Groq /models), muss Tool-Calling können
GROQ_MODEL=
POLL_SECONDS=10
# SAP-OData-Service (GWSAMPLE_BASIC), z. B. https://<host>:<port>/sap/opu/odata/iwbep/GWSAMPLE_BASIC
SAP_SERVICE_ROOT=
SAP_USER=
SAP_PASSWORD=
# Nur für lokale Testsysteme mit selbstsigniertem Zertifikat auf false setzen
SAP_VERIFY_TLS=true
# Optional: fester SAP-Kunde für DEMO_SENDER (LLM kann dann keine anderen Kunden abfragen)
DEMO_CUSTOMER=
